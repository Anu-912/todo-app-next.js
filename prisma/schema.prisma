generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id          String       @id @default(nanoid())
  useremail   String       @unique
  otp         String?
  otpTries    Int          @default(0)
  phoneNumber String?
  address     String?
  role        UserRole     @default(USER)
  ttl         DateTime?
  isVerified  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  foodOrders  FoodOrders[]
}

model FoodCategories {
  id           String   @id @default(nanoid())
  categoryName String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  foods        Foods[]
}

model Foods {
  id              String         @id @default(nanoid())
  foodName        String
  price           Float
  image           String?
  ingredients     String?
  foodDescription String?
  categoryId      String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  category        FoodCategories @relation(fields: [categoryId], references: [id])
}

model FoodOrders {
  id             String          @id @default(nanoid())
  userId         String
  totalPrice     Float
  foodOrderItems Json
  status         FoodOrderStatus @default(PENDING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           Users           @relation(fields: [userId], references: [id])
}

enum UserRole {
  USER
  ADMIN
}

enum FoodOrderStatus {
  PENDING
  CANCELED
  DELIVERED
}
